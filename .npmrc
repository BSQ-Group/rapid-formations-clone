legacy-peer-deps=true
enable-pre-post-scripts=true

# FontAwesome Pro is a licence-gated registry. The token is deliberately NOT committed
# -- it is read from FONTAWESOME_NPM_AUTH_TOKEN in the environment.
#
#   local:   export FONTAWESOME_NPM_AUTH_TOKEN=... in your shell profile
#   Vercel:  add it to the project's environment variables
#
# Without it, `bun install` cannot resolve @fortawesome/pro-* and the build fails.
@fortawesome:registry=https://npm.fontawesome.com/
//npm.fontawesome.com/:_authToken=${FONTAWESOME_NPM_AUTH_TOKEN}
